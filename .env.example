# Supabase 项目配置
# 登录 https://supabase.com → 你的项目 → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# anon/public key（公开可暴露在前端代码中）
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 公共只读账号（用于访客查看模式，不配置则禁用该功能）
VITE_PUBLIC_EMAIL=guest@example.com
VITE_PUBLIC_USERNAME=guest

# 是否允许用户自行注册（关闭后仅保留登录，新用户需管理员在 Supabase Dashboard 手动创建）
VITE_ALLOW_REGISTRATION=true
